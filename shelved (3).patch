<+>/*\r\n * To change this license header, choose License Headers in Project Properties.\r\n * To change this template file, choose Tools | Templates\r\n * and open the template in the editor.\r\n */\r\npackage thegreattribes.core.ui;\r\n\r\nimport static org.lwjgl.opengl.GL11.GL_TEXTURE_2D;\r\nimport static org.lwjgl.opengl.GL11.glBindTexture;\r\nimport static org.lwjgl.opengl.GL13.GL_TEXTURE0;\r\nimport static org.lwjgl.opengl.GL13.glActiveTexture;\r\nimport static thegreattribes.core.ui.ButtonState.NOT_ACTIVE;\r\nimport static thegreattribes.core.ui.ButtonState.PRESSED;\r\nimport static thegreattribes.core.ui.ButtonState.RELEASED;\r\nimport lombok.Getter;\r\nimport lombok.Setter;\r\nimport org.joml.Vector2i;\r\nimport thegreattribes.core.audio.AudioSource;\r\nimport thegreattribes.core.textures.Texture2D;\r\n\r\n/**\r\n * @author ygyl\r\n */\r\npublic abstract class Button extends Component {\r\n  @Setter private Texture2D textureReleased;\r\n  @Setter private Texture2D texturePressed;\r\n  @Setter private Texture2D textureHovered;\r\n  @Setter private Texture2D textureNotActive;\r\n\r\n  @Getter private ButtonState state = RELEASED;\r\n  @Getter private boolean pressed = false;\r\n  @Getter private boolean hovered = false;\r\n  @Getter private ToggleButtonGroup toggleGroup;\r\n  @Getter private int toggleIndex = -1;\r\n  @Setter private AudioSource sourceHover;\r\n  @Setter private AudioSource sourceClick;\r\n\r\n  public Button(Vector2i position, Vector2i dimension) {\r\n    super(position, dimension);\r\n  }\r\n\r\n  @Override\r\n  public void cleanup() {\r\n    if (textureReleased != null && !textureReleased.isCached()) textureReleased.cleanup();\r\n    if (texturePressed != null && !texturePressed.isCached()) texturePressed.cleanup();\r\n    if (textureHovered != null && !textureHovered.isCached()) textureHovered.cleanup();\r\n    if (textureNotActive != null && !textureNotActive.isCached()) textureNotActive.cleanup();\r\n  }\r\n\r\n  @Override\r\n  public void render() {\r\n    glActiveTexture(GL_TEXTURE0);\r\n\r\n    if (hovered) {\r\n      glBindTexture(GL_TEXTURE_2D, textureHovered.getId());\r\n    } else\r\n      switch (state) {\r\n        case RELEASED -> glBindTexture(GL_TEXTURE_2D, textureReleased.getId());\r\n        case PRESSED -> glBindTexture(GL_TEXTURE_2D, texturePressed.getId());\r\n        case NOT_ACTIVE -> glBindTexture(GL_TEXTURE_2D, textureNotActive.getId());\r\n      }\r\n    UserInterface.getInstance().render(this);\r\n  }\r\n\r\n  @Override\r\n  public void callbackMouseClick(long window, int button) {\r\n    if (toggleGroup == null) {\r\n      setPressed(!isPressed());\r\n    } else {\r\n      if (!isPressed()) {\r\n        setPressed(true);\r\n      }\r\n    }\r\n  }\r\n\r\n  @Override\r\n  public void callbackMouseExited(long window, double xPos, double yPos) {\r\n    setHovered(false);\r\n  }\r\n\r\n  @Override\r\n  public void callbackMouseEntered(long window, double xPos, double yPos) {\r\n    if (!isPressed()) {\r\n      setHovered(true);\r\n    }\r\n  }\r\n\r\n  public void setState(ButtonState state) {\r\n    this.state = state;\r\n    pressed = state == PRESSED;\r\n    if (state == NOT_ACTIVE) {\r\n      setClickable(false);\r\n      hovered = false;\r\n    } else {\r\n      setClickable(true);\r\n    }\r\n  }\r\n\r\n  public void setPressed(boolean pressed) {\r\n    if (!isPressed() & pressed) {\r\n      if (sourceClick != null) {\r\n        sourceClick.play();\r\n      }\r\n    }\r\n    this.pressed = pressed;\r\n    if (pressed) {\r\n      state = PRESSED;\r\n      if (toggleGroup != null) {\r\n        toggleGroup.setPressedButton(this);\r\n      }\r\n      hovered = false;\r\n    } else {\r\n      state = RELEASED;\r\n    }\r\n  }\r\n\r\n  public void setHovered(boolean isHovered) {\r\n    hovered = isHovered;\r\n    if (hovered && sourceHover != null) {\r\n      sourceHover.play();\r\n    }\r\n  }\r\n\r\n  public void setToggleGroup(ToggleButtonGroup toggleGroup) {\r\n    this.toggleGroup = toggleGroup;\r\n    toggleIndex = toggleGroup.buttons.size();\r\n    toggleGroup.buttons.add(this);\r\n  }\r\n\r\n  @Override\r\n  public void setClickable(boolean isClickable) {\r\n    super.setClickable(isClickable);\r\n    if (isClickable) {\r\n      if (state == NOT_ACTIVE) state = RELEASED;\r\n    } else {\r\n      state = NOT_ACTIVE;\r\n    }\r\n  }\r\n}\r\n
