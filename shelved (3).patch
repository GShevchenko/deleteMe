+package thegreattribes.core.ui;
+
+
+
+
+import java.awt.AlphaComposite;
+import java.awt.Color;
+import java.awt.Font;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.image.BufferedImage;
+import org.joml.Vector2i;
+import thegreattribes.client.render.Render;
+import thegreattribes.core.textures.Texture2D;
+import thegreattribes.core.textures.TextureCreator;
+import thegreattribes.utils.TextToBufferedImage;
+
+/**
+ * Заголовок вкладки с исчезающей текстурной подложкой.
+ * @author Zemlaynin
+ */
+import org.apache.batik.transcoder.TranscoderException; // или ваш импорт TranscoderException
+
+import java.awt.AlphaComposite;
+import java.awt.Color;
+import java.awt.Font;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.image.BufferedImage;
+import org.joml.Vector2i;
+import thegreattribes.core.textures.Texture2D;
+import thegreattribes.core.textures.TextureCreator;
+import thegreattribes.utils.TextToBufferedImage;
+
+public class TabHeaderButton extends Button {
+
+  public TabHeaderButton(
+      Vector2i position,
+      Vector2i dimension,
+      String text,
+      Font font,
+      Align align,
+      Color colorNotActive,
+      Color colorActive,
+      int xOffset,
+      int yOffset,
+      int leftCorner,  // Принимаем радиус скругления (например, 15 или 0)
+      int rightCorner) {
+
+    super(position, dimension);
+
+    // 🎯 ЗАЩИТА ОТ КРАША BATIK: Если передан 0 (острый угол),
+    // подменяем его на минимальный 1 пиксель, чтобы LengthKey не выбрасывал ошибку!
+    int safeLeft = (leftCorner <= 0) ? 1 : leftCorner;
+    int safeRight = (rightCorner <= 0) ? 1 : rightCorner;
+
+    // ======================================================================
+    // 1. СОСТОЯНИЕ RELEASED (Вкладка закрыта)
+    // ======================================================================
+    BufferedImage textImgNotActive = TextToBufferedImage.builder()
+        .dimension(dimension)
+        .text(text)
+        .font(font)
+        .align(align)
+        .textColor(colorNotActive)
+        .xOffset(xOffset)
+        .yOffset(yOffset)
+        .isDrawRect(false)
+        .build()
+        .getImage();
+
+    BufferedImage imgReleased = new BufferedImage(dimension.x, dimension.y, BufferedImage.TYPE_4BYTE_ABGR);
+    Graphics2D g2 = imgReleased.createGraphics();
+    g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+
+    try {
+      // Передаем безопасные радиусы скругления в Batik-генератор
+      BufferedImage topPanel = Render.getInstance()
+          .getUiGame()
+          .getCreatorPanelImage()
+          .getPanelImage(dimension.x, dimension.y, safeLeft, safeRight);
+
+      g2.setComposite(AlphaComposite.Src);
+      g2.drawImage(topPanel, 0, 0, null);
+      g2.setComposite(AlphaComposite.SrcOver);
+    } catch (Exception e) {
+      System.err.println("Ошибка SVG: " + e.getMessage());
+    }
+
+    g2.drawImage(textImgNotActive, 0, 0, null);
+    g2.dispose();
+
+    Texture2D releasedTexture = TextureCreator.createTexture(imgReleased);
+    setTextureReleased(releasedTexture);
+
+    // ======================================================================
+    // 2. СОСТОЯНИЕ PRESSED (Вкладка открыта) — СТРОГАЯ ЗАЩИТА ОТ NPE
+    // ======================================================================
+    BufferedImage textImgActive = TextToBufferedImage.builder()
+        .dimension(dimension)
+        .text(text)
+        .font(font)
+        .align(align)
+        .textColor(colorActive)
+        .xOffset(xOffset)
+        .yOffset(yOffset)
+        .isDrawRect(false)
+        .build()
+        .getImage();
+
+    // Гарантируем, что создаем честную текстуру. Даже если она прозрачная,
+    // у нее БУДЕТ легальный OpenGL ID, и игра больше никогда не упадет!
+    Texture2D pressedTexture = TextureCreator.createTexture(textImgActive);
+    setTexturePressed(pressedTexture);
+
+    // Заполняем оставшиеся состояния, чтобы избежать NullPointerException
+    setTextureHovered(releasedTexture);
+    setTextureNotActive(releasedTexture);
+  }
+
+  @Override
+  public void callbackMouseButton(long window, int button, int action, int mods) {
+
+  }
+
+  @Override
+  public void callbackMousePosition(long window, double xPos, double yPos) {
+
+  }
+
+  @Override
+  public void callbackMouseScroll(long window, double xOffset, double yOffset) {
+
+  }
+
+  @Override
+  public void callbackKey(long window, int key, int scancode, int action, int mods) {
+
+  }
+}
