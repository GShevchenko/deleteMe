    getVisualization().setSeason((byte) 0);\r\n    getVisualization().setAnimationMoveUnitsStarted(false);\r\n    Render.getInstance().getGamer().setTurnCompleted(false);\r\n    getVisualization().setNeedRecalculation(true);\r\n    this.turn = turn;\r\n    getUiGame().update();\r\n    getUiGame().getEndTurnButton().setState(ButtonState.RELEASED);\r\n\r\n    //    Render.getInstance().getUiGame().headlines.getHeadlinesUnitMap().get(u).setSelected(true);\r\n    //\r\n    // Render.getInstance().getVisualization().getCurrentBufferVisibleCells().getBufferHeadlinesCells().ge\r\n    // Render.getInstance().getGameCallBack().setSelectedHeadlines();\r\n\r\n    //    userGameInterface.buttonEndTurn.changeState(0);\r\n    //    if (userGameInterface.buttonEndTurn.isContainsMousePoint(\r\n    //        getGameCallBack().mousePosition.x, getGameCallBack().mousePosition.y)) {\r\n    //      userGameInterface.buttonEndTurn.setState(1);\r\n    //    } else {\r\n    //      userGameInterface.buttonEndTurn.setState(0);\r\n    //    }\r\n    isAnimatedTurn = false;\r\n    visualization.setNeedGameStartNewTurn(false);\r\n    // uiGame.update();\r\n    //    userGameInterface.minimapPanel.rebindAllTexture(Render.getInstance().gamer);\r\n\r\n    if (getGameCallBack().getSelectedUnit() != null) {\r\n      //      if (getGameCallBack().getSelectedUnit().getPath().isEmpty()) {\r\n      // TODO\r\n      //        getGameCallBack()\r\n      //            .getSelectedUnit()\r\n      //            .getPath()\r\n      //            .add(getGameCallBack().getSelectedUnit().getParentCell());\r\n      //      }\r\n    }\r\n  }\r\n\r\n  public void cleanUp() {\r\n    isGameRunning = false;\r\n\r\n    if (uiMenu != null) {\r\n      uiMenu.cleanup();\r\n    }\r\n    uiMenu = null;\r\n    if (!texturePreloader.isLoadingFinished()) {\r\n      threadTextureLoader.interrupt();\r\n    }\r\n    texturePreloader.cleanUp();\r\n\r\n    UserInterface.getInstance().cleanUp();\r\n\r\n    Object3DCache.getInstance().cleanUp();\r\n    TextureCache.getInstance().cleanup();\r\n\r\n    if (soundSystem != null) {\r\n      soundSystem.cleanUp();\r\n    }\r\n\r\n    //TODO audio system\r\n//    if (animalSoundManager != null) {\r\n//      animalSoundManager.cleanup();\r\n//      animalSoundManager = null;\r\n//    }\r\n\r\n    if (uiGame != null) {\r\n      uiGame.cleanup();\r\n    }\r\n    if (renderMethods != null) {\r\n      renderMethods.cleanUp();\r\n    }\r\n    if (server != null) {\r\n      server.exit();\r\n    }\r\n    server = null;\r\n    UserInterface.getInstance().cleanUp();\r\n  }\r\n\r\n  public void exit() {\r\n    LOG.info(\"Call to exit method.\");\r\n    cleanUp();\r\n    isRenderRunning = false;\r\n    glfwSetWindowShouldClose(windowHandle, true);\r\n    glfwFreeCallbacks(windowHandle);\r\n    glfwDestroyWindow(windowHandle);\r\n    glfwSetWindowShouldClose(windowHandleTextureBinder, true);\r\n    glfwDestroyWindow(windowHandleTextureBinder);\r\n    glfwSetWindowShouldClose(windowHandleUI, true);\r\n    glfwDestroyWindow(windowHandleUI);\r\n    System.gc();\r\n    System.exit(0);\r\n\r\n    Thread.getAllStackTraces()\r\n        .keySet()\r\n        .forEach(\r\n            t -> {\r\n              LOG.info(\"\" + t.getName());\r\n            });\r\n  }\r\n\r\n  public void exitGame() {\r\n    UserInterface.getInstance().setContainer(uiMenu);\r\n    UserInterface.getInstance().setCallBacks(new RenderCallBackMenu());\r\n    setStepRendering(StepRendering.MAIN_MENU);\r\n    uiMenu.menuPanel.setVisible(true);\r\n    uiMenu.closeLoaderPanel();\r\n\r\n    isGameRunning = false;\r\n\r\n    if (server != null) {\r\n      server.exit();\r\n      server = null;\r\n    }\r\n\r\n    visualization.cleanup();\r\n    glFinish();\r\n    glFlush();\r\n    System.gc();\r\n    LOG.info(\"Exit game\");\r\n    uiMenu.preloadNextLogoLoaderPanel();\r\n  }\r\n\r\n  public long getMonitorIDFromIndex(int index) {\r\n    long monitorID;\r\n    if (index == 0) {\r\n      monitorID = glfwGetPrimaryMonitor();\r\n    } else {\r\n      try {\r\n        PointerBuffer pb = glfwGetMonitors();\r\n        monitorID = pb.get(index - 1);\r\n      } catch (Exception e) {\r\n        monitorID = glfwGetPrimaryMonitor();\r\n      }\r\n    }\r\n    return monitorID;\r\n  }\r\n\r\n  public GLFWVidMode getGLFWVidModeFromIndex(int index) {\r\n    GLFWVidMode m;\r\n    if (index == 0) {\r\n      m = glfwGetVideoMode(viewPort.getMonitor());\r\n    } else {\r\n      try {\r\n        m =\r\n            glfwGetVideoModes(viewPort.getMonitor())\r\n                .get(RenderProperties.getInstance().getVidMode() - 1);\r\n      } catch (Exception e) {\r\n        m = glfwGetVideoMode(viewPort.getMonitor());\r\n      }\r\n    }\r\n    return m;\r\n  }\r\n\r\n  public void loadViewPort() {\r\n    viewPort.setMonitor(getMonitorIDFromIndex(RenderProperties.getInstance().getMonitor()));\r\n    viewPort.setMonitorMode(getGLFWVidModeFromIndex(RenderProperties.getInstance().getVidMode()));\r\n  }\r\n\r\n  public void switchFullScreen(RestoredPanel restoredPanel) {\r\n    RenderProperties.getInstance().setFullScreen(!RenderProperties.getInstance().isFullScreen());\r\n    setViewPortMode(restoredPanel);\r\n  }\r\n\r\n  public void setViewPortMode(RestoredPanel restoredPanel) {\r\n    loadViewPort();\r\n    if (!RenderProperties.getInstance().isFullScreen()) {\r\n      glfwSetWindowMonitor(\r\n          windowHandle,\r\n          NULL,\r\n          0,\r\n          0,\r\n          viewPort.getWidth(),\r\n          viewPort.getHeight(),\r\n          viewPort.getMonitorMode().refreshRate());\r\n\r\n      long a = glfwGetPrimaryMonitor();\r\n      GLFWVidMode mode = glfwGetVideoMode(a);\r\n      glfwSetWindowPos(\r\n          windowHandle,\r\n          (mode.width() - viewPort.getWidth()) / 2,\r\n          (mode.height() - viewPort.getHeight()) / 2);\r\n    } else {\r\n      glfwSetWindowMonitor(\r\n          windowHandle,\r\n          viewPort.getMonitor(),\r\n          0,\r\n          0,\r\n          viewPort.getWidth(),\r\n          viewPort.getHeight(),\r\n          viewPort.getMonitorMode().refreshRate());\r\n    }\r\n    glfwSwapInterval(RenderProperties.getInstance().getSwapInterval());\r\n    glViewport(0, 0, viewPort.getWidth(), viewPort.getHeight());\r\n\r\n    UserInterface.getInstance().setScale(viewPort.getScale());\r\n    UserInterface.getInstance().updateViewPort();\r\n\r\n    uiMenu.cleanup();\r\n    uiMenu = new UserInterfaceMenu();\r\n    uiMenu.init(restoredPanel);\r\n\r\n    if (isGameRunning) {\r\n      visualization.updateViewPort();\r\n      renderMethods.updateProjectionMatrix(visualization);\r\n      uiGame.cleanup();\r\n      uiGame = new UserInterfaceGame();\r\n      uiGame.init();\r\n      visualization.recalculateALL();\r\n      UserInterface.getInstance().setContainer(uiGame);\r\n    } else {\r\n      UserInterface.getInstance().setContainer(uiMenu);\r\n    }\r\n  }\r\n\r\n  public void switchUIScale(RestoredPanel restoredPanel) {\r\n    viewPort.updateScale();\r\n    UserInterface.getInstance().setScale(viewPort.getScale());\r\n    uiMenu.cleanup();\r\n    uiMenu = new UserInterfaceMenu();\r\n    uiMenu.init(restoredPanel);\r\n    if (isGameRunning) {\r\n      uiGame.cleanup();\r\n      uiGame = new UserInterfaceGame();\r\n      uiGame.init();\r\n      visualization.recalculateALL();\r\n      UserInterface.getInstance().setContainer(uiGame);\r\n    } else {\r\n      UserInterface.getInstance().setContainer(uiMenu);\r\n    }\r\n  }\r\n\r\n  //  public void checkAndUpdate(Player player) {\r\n  //    if (Render.getInstance().gamer == player) {\r\n  //      Render.getInstance().userGameInterface.headlines.update();\r\n  //    }\r\n  //  }\r\n\r\n  public void switchCursorMode() {\r\n\r\n    if (visualization.isDrawCursor()) {\r\n      glfwSetInputMode(windowHandle, GLFW_CURSOR, GLFW_CURSOR_NORMAL);\r\n    } else {\r\n      glfwSetInputMode(windowHandle, GLFW_CURSOR, GLFW_CURSOR_DISABLED);\r\n    }\r\n  }\r\n\r\n  public void 