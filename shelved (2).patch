tton, int action, int mods) {}\r\n\r\n  @Override\r\n  public void callbackMousePosition(long window, double xPos, double yPos) {}\r\n\r\n  @Override\r\n  public void callbackMouseScroll(long window, double xOffset, double yOffset) {}\r\n\r\n  @Override\r\n  public void callbackMouseClick(long window, int button) {}\r\n\r\n  @Override\r\n  public void callbackMouseExited(long window, double xPos, double yPos) {}\r\n\r\n  @Override\r\n  public void callbackMouseEntered(long window, double xPos, double yPos) {}\r\n\r\n  @Override\r\n  public void callbackKey(long window, int key, int scancode, int action, int mods) {}\r\n\r\n  public BufferedImage setText(String text) {\r\n\r\n    BufferedImage image =\r\n        TextToBufferedImage.builder()\r\n            .dimension(getDimensionOnScreen())\r\n            .text(text)\r\n            .textColor(color)\r\n            .font(font)\r\n            .align(align)\r\n            .wrapping(wrapping)\r\n            .build()\r\n            .getImage();\r\n\r\n    Graphics2D g2 = (Graphics2D) image.getGraphics();\r\n    if (isDrawRect) {\r\n      g2.setColor(Color.BLACK);\r\n      float scale = UserInterface.getInstance().getScale();\r\n      g2.setStroke(new BasicStroke(scale));\r\n      g2.drawRect(\r\n          (int) (1 * scale),\r\n          (int) (1 * scale),\r\n          (int) (getDimensionOnScreen().x - 2 * scale),\r\n          (int) (getDimensionOnScreen().y - 2 * scale));\r\n    }\r\n    if (texture != null) {\r\n      TextureCreator.rebindTexture(texture, image);\r\n    } else texture = TextureCreator.createTexture(image);\r\n    return image;\r\n  }\r\n}\r\n
